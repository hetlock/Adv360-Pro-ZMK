#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/* =============================================================================
   COMPLETE GERMAN WINDOWS TRANSLATION ALIASES
   Erase "#include <locale/keys_de.h>" and use these exact labels anywhere!
   ============================================================================= */
#define DE_A            A
#define DE_B            B
#define DE_C            C
#define DE_D            D
#define DE_E            E
#define DE_F            F
#define DE_G            G
#define DE_H            H
#define DE_I            I
#define DE_J            J
#define DE_K            K
#define DE_L            L
#define DE_M            M
#define DE_N            N
#define DE_O            O
#define DE_P            P
#define DE_Q            Q
#define DE_R            R
#define DE_S            S
#define DE_T            T
#define DE_U            U
#define DE_V            V
#define DE_W            W
#define DE_X            X
#define DE_Y            Z              /* Correctly swaps Y and Z physical positions */
#define DE_Z            Y              /* Correctly swaps Z and Y physical positions */

#define DE_1            N1
#define DE_2            N2
#define DE_3            N3
#define DE_4            N4
#define DE_5            N5
#define DE_6            N6
#define DE_7            N7
#define DE_8            N8
#define DE_9            N9
#define DE_0            N0

#define DE_A_UMLAUT     SQT            /* ä */
#define DE_O_UMLAUT     SEMI           /* ö */
#define DE_U_UMLAUT     LBKT           /* ü */
#define DE_SHARP_S      MINUS          /* ß */

#define DE_MINUS        SLASH          /* - */
#define DE_PLUS         RBKT           /* + */
#define DE_EQUAL        LS(N0)         /* = */
#define DE_UNDERSCORE   LS(SLASH)      /* _ */

#define DE_LESS_THAN    NON_US_BSLH    /* < */
#define DE_GREATER_THAN LS(NON_US_BSLH) /* > */
#define DE_PIPE         RA(NON_US_BSLH) /* | */

#define DE_EXCLAMATION  LS(N1)         /* ! */
#define DE_DOUBLE_QUOTES LS(N2)        /* " */
#define DE_SECTION      LS(N3)         /* § */
#define DE_DOLLAR       LS(N4)         /* $ */
#define DE_PERCENT      LS(N5)         /* % */
#define DE_AMPERSAND    LS(N6)         /* & */
#define DE_SLASH        LS(N7)         /* / */
#define DE_QUESTION     LS(MINUS)      /* ? */
#define DE_BACKSLASH    RA(MINUS)      /* \ */

#define DE_LEFT_PARENTHESIS  LS(N8)    /* ( */
#define DE_RIGHT_PARENTHESIS LS(N9)    /* ) */
#define DE_LEFT_BRACKET      RA(N8)    /* [ */
#define DE_RIGHT_BRACKET     RA(N9)    /* ] */
#define DE_LEFT_BRACE        RA(N7)    /* { */
#define DE_RIGHT_BRACE       RA(N0)    /* } */

#define DE_PERIOD       DOT            /* . */
#define DE_COMMA        COMMA          /* , */
#define DE_COLON        LS(DOT)        /* : */
#define DE_SEMICOLON    LS(COMMA)      /* ; */
#define DE_HASH         NON_US_HASH    /* # */
#define DE_SINGLE_QUOTE LS(NON_US_HASH) /* ' */
#define DE_ASTERISK     LS(RBKT)       /* * */

#define DE_AT           RA(Q)          /* @ */
#define DE_EURO         RA(E)          /* € */
#define DE_TILDE        RA(RBKT)       /* ~ */
#define DE_GRAVE        LS(EQUAL)      /* ` (Dead Key) */
#define DE_ACUTE        EQUAL          /* ´ (Dead Key) */
#define DE_CARET        GRAVE          /* ^ (Dead Key) */
#define DE_DEGREE       LS(GRAVE)      /* ° */
/* ============================================================================= */


/* 
================================================================================
  MASTER GERMAN ZMK LOCALE REFERENCE CHEAT SHEET
  Requires: #include <locale/keys_de.h> at the top of your keymap file.
================================================================================
  Symbol/Char      | ZMK German Keycode | Description / Shortcut Used
-------------------|--------------------|---------------------------------------
  ALPHABET (QWERTZ)
  A to Y (except Z)| &kp DE_A ... DE_Y  | Follows standard physical keys
  Z (Swapped)      | &kp DE_Z           | Maps to physical Y position
  Y (Swapped)      | &kp DE_Y           | Maps to physical Z position
  
  GERMAN SPECIALS
  ä (Umlaut)       | &kp DE_A_UMLAUT    | Base key
  ö (Umlaut)       | &kp DE_O_UMLAUT    | Base key
  ü (Umlaut)       | &kp DE_U_UMLAUT    | Base key
  ß (Eszett)       | &kp DE_SHARP_S     | Base key
  § (Section)      | &kp DE_SECTION     | Shift + 3
  ° (Degree)       | &kp DE_DEGREE      | Shift + ^

  STANDARD PUNCTUATION & SYMBOLS
  . (Period)       | &kp DE_PERIOD      | Base key
  , (Comma)        | &kp DE_COMMA       | Base key
  - (Minus / Dash) | &kp DE_MINUS       | Base key
  _ (Underscore)   | &kp DE_UNDERSCORE  | Shift + Minus
  + (Plus)         | &kp DE_PLUS        | Base key
  # (Hash)         | &kp DE_HASH        | Base key
  ' (Single Quote) | &kp DE_SINGLE_QUOTE| Shift + #
  * (Asterisk)     | &kp DE_ASTERISK    | Shift + +
  ~ (Tilde)        | &kp DE_TILDE       | AltGr + +
  ^ (Caret)        | &kp DE_CARET       | Base key (Dead key on OS)

  PROGRAMMING OPERATORS
  = (Equals)       | &kp DE_EQUAL       | Shift + 0
  ! (Exclamation)  | &kp DE_EXCLAMATION | Shift + 1
  ? (Question Mark)| &kp DE_QUESTION    | Shift + ß
  / (Forward Slash)| &kp DE_SLASH       | Shift + 7
  \ (Backslash)    | &kp DE_BACKSLASH   | AltGr + ß

  | (Pipe)         | &kp DE_PIPE        | AltGr + <
  : (Colon)        | &kp DE_COLON       | Shift + Period
  ; (Semicolon)    | &kp DE_SEMICOLON   | Shift + Comma

  BRACKETS & ENCLOSURES
  ( (Left Paren)   | &kp DE_LEFT_PARENTHESIS | Shift + 8
  ) (Right Paren)  | &kp DE_RIGHT_PARENTHESIS| Shift + 9
  [ (Left Bracket) | &kp DE_LEFT_BRACKET     | AltGr + 8
  ] (Right Bracket)| &kp DE_RIGHT_BRACKET    | AltGr + 9
  { (Left Brace)   | &kp DE_LEFT_BRACE       | AltGr + 7
  } (Right Brace)  | &kp DE_RIGHT_BRACE      | AltGr + 0
  < (Less Than)    | &kp DE_LESS_THAN        | Base key
  > (Greater Than) | &kp DE_GREATER_THAN     | Shift + <

  COMMON INTERNET & CURRENCY SYMBOLS
  @ (At Sign)      | &kp DE_AT          | AltGr + Q
  € (Euro)         | &kp DE_EURO        | AltGr + E
  $ (Dollar)       | &kp DE_DOLLAR      | Shift + 4
  % (Percent)      | &kp DE_PERCENT     | Shift + 5
  & (Ampersand)    | &kp DE_AMPERSAND   | Shift + 6
  " (Double Quote) | &kp DE_DOUBLE_QUOTES| Shift + 2
  ` (Backtick)     | &kp DE_GRAVE       | Shift + ´ (Dead key on OS)
  ´ (Acute Accent) | &kp DE_ACUTE       | Base key (Dead key on OS)
================================================================================
*/

/* 
================================================================================
  ZMK SYSTEM, CORE BEHAVIORS, & CONTROLS REFERENCE CHEAT SHEET
  This table lists standard ZMK actions, layers, media, and hardware keys.
================================================================================
  ZMK Identifier        | Description / Action
------------------------|-------------------------------------------------------
  CORE CORE ACTIONS
  &none                 | Null key. Disables the key completely (does nothing).
  &trans                | Transparent. Falls through to the layer below.

  HARDWARE & SYSTEM CONTROLS
  &bootloader           | Puts module into USB mass storage flash mode.
  &sys_reset            | Reboots the microcontroller immediately.
  &macro_ver            | Outputs the current firmware version string.

  BLUETOOTH CONTROLS
  &bt BT_CLR            | Clears the Bluetooth pairing bond on the active profile.
  &bt BT_CLR_ALL        | Clears ALL Bluetooth profiles saved on the keyboard.
  &bt BT_SEL 0          | Selects Bluetooth Profile 0.
  &bt BT_SEL 1          | Selects Bluetooth Profile 1.
  &bt BT_SEL 2          | Selects Bluetooth Profile 2.
  &bt BT_SEL 3          | Selects Bluetooth Profile 3.
  &bt BT_SEL 4          | Selects Bluetooth Profile 4.
  &bt BT_PRV            | Switches to the previous Bluetooth profile slot.
  &bt BT_NXT            | Switches to the next Bluetooth profile slot.

  LAYER NAVIGATION CONTROLS
  &mo 1                 | Momentary Layer: Activates Layer 1 only while held.
  &to 1                 | Toggle Layer: Permanently switches to Layer 1.
  &sl 1                 | Sticky Layer: Activates Layer 1 for the next single keypress.
  &tg 1                 | Toggle Layer Switch: Press to turn on, press to turn off.

  FUNCTION KEYS
  &kp F1 ... &kp F12    | Standard Function Keys F1 through F12.
  &kp F13 ... &kp F24   | Extended Function Keys F13 through F24.

  NUMPAD & TOP ROW NUMBERS
  &kp N1 ... &kp N0     | Numeric keys 1 through 0 on the top number row.
  &kp KP_N1 ... &kp KP_N0| Numpad Number keys 1 through 0.
  &kp KP_MULTIPLY       | Numpad Asterisk (*)
  &kp KP_PLUS           | Numpad Plus (+)
  &kp KP_MINUS          | Numpad Minus (-)
  &kp KP_DOT            | Numpad Decimal Dot (.)
  &kp KP_ENTER          | Numpad Enter key.

  NAVIGATION & CURSOR CONTROLS
  &kp UP                | Arrow Key Up
  &kp DOWN              | Arrow Key Down
  &kp LEFT              | Arrow Key Left
  &kp RIGHT             | Arrow Key Right
  &kp HOME              | Home Key (Jump to beginning of line)
  &kp END               | End Key (Jump to end of line)
  &kp PG_UP             | Page Up
  &kp PG_DN             | Page Down
  &kp INS               | Insert Key
  &kp DEL               | Delete Forward Key

  EDITING & MODIFIERS
  &kp BSPC              | Backspace (Delete backward)
  &kp SPACE             | Spacebar
  &kp RET               | Return / Enter Key
  &kp TAB               | Tabulator Key
  &kp ESC               | Escape Key
  &kp LSHIFT / &kp RSHIFT| Left Shift / Right Shift
  &kp LCTRL  / &kp RCTRL | Left Control / Right Control
  &kp LALT   / &kp RALT  | Left Alt / Right Alt (German: Alt)
  &kp RGUI   / &kp LGUI  | Right Windows-Key / Left Windows-Key (Command on Mac)
  &kp CAPS              | Caps Lock

  MEDIA & AUDIO CONTROLS
  &kp C_MUTE            | Mute Audio Output
  &kp C_VOL_UP          | Increase Audio Volume
  &kp C_VOL_DN          | Decrease Audio Volume
  &kp C_PP              | Media Play / Pause
  &kp C_NEXT            | Media Next Track
  &kp C_PREV            | Media Previous Track
  &kp C_STOP            | Media Stop Playback
================================================================================
  &cpp_deref            | for macro cpp_deref

*/

/*
===============================================================================
 ZMK BEHAVIOR REFERENCE
===============================================================================

 A binding consists of a behavior and its arguments:
   &kp SPACE  = normal key press, using the Space keycode
   &sk LSHIFT = sticky key, using the Left Shift keycode

 KEY BEHAVIORS
-------------------------------------------------------------------------------
 Example                 | Meaning
-------------------------|-----------------------------------------------------
 &kp SPACE               | Key press: normal Space key.
 &sk LSHIFT              | Sticky key: tap Shift, then type the next key.
 &kt LSHIFT              | Key toggle: tap to hold Shift; tap again to release.
 &mt LCTRL ESC           | Mod-tap: hold for Ctrl; tap for Escape.
 &trans                  | Use the next active layer underneath.
 &none                   | No action; also blocks the layers underneath.
 &caps_word              | Capitalize a word; Space ends capitalization.
 &key_repeat             | Repeat the last keycode sent.

 LAYER BEHAVIORS
-------------------------------------------------------------------------------
 Example                 | Meaning
-------------------------|-----------------------------------------------------
 &mo 4                   | Momentary: activate layer 4 while held.
 &sl 4                   | Sticky: tap, then use one key from layer 4.
 &tog 4                  | Toggle: turn layer 4 on or off.
 &to 4                   | Activate layer 4; disable other layers except Base.
 &to 0                   | Return to Base; disable the other layers.
 &lt 4 SPACE             | Layer-tap: hold for layer 4; tap for Space.

 KEYBOARD CONTROLS
-------------------------------------------------------------------------------
 Example                 | Meaning
-------------------------|-----------------------------------------------------
 &bt BT_SEL 0            | Select Bluetooth profile 0.
 &bl BL_TOG              | Toggle the keyboard backlight.
 &studio_unlock          | Unlock editing through Studio/Clique.
 &sys_reset              | Restart the keyboard firmware.
 &bootloader             | Enter firmware-flashing mode.

 CUSTOM BEHAVIORS IN THIS KEYMAP
-------------------------------------------------------------------------------
 Example                 | Meaning
-------------------------|-----------------------------------------------------
 &cpp_deref_de           | Run the custom macro that types ->.
 &hl 2 DE_U              | Tap: u. Hold: Num layer (2) for as long as U is held.
 &hl 2 ENTER             | Tap: Enter. Hold: Num layer (2), same as holding U.
 &he 3 DE_6              | Tap: 6. Hold: Edit layer (3), like U for Num.
 &hs 3 SPACE             | Tap: space. Hold 200 ms: Edit layer (3). Tap+hold: repeat.
 &cpp_scope              | Types :: (Red + Base M).
 &cpp_not_equal          | Types != (Red + Base Z).
 &cpp_logical_and        | Types && (Red + Base L).
 &cpp_logical_or         | Types || (Red + Base 1).
 &cpp_less_equal         | Types <= (Red + Base ,).
 &cpp_greater_equal      | Types >= (Red + Base D).
 &sqt_dqt                | Types '; with Shift it types ".
 &td_shift               | Tap: sticky Shift. Double-tap: Caps Word.
 &hb 3 0 (Backspace)     | Tap: Backspace (Shift: Delete). Hold 200 ms: Edit layer.
                         | Tap then hold: repeat Backspace.
 &del_bspc (Del key)     | Delete; Shift + Del key = Backspace.
 &semi_bracket &equal_bracket | Old arrow keys: ; = (with Shift [ ]).
 &paren_brace_l/_r       | Old arrow keys: ( ) (with Shift { }).

 <  is on the Esc position (Shift: >). Esc = symbol key (Red), then that key.

 NOTES
-------------------------------------------------------------------------------
 - Layer numbers start at 0. In this keymap:
   0 = Base, 1 = Red (symbol key), 2 = Num (hold U or Enter),
   3 = Edit (hold 6, Space or Backspace), 4-6 = free,
   7 = Mod (hold the Mod key; highest layer, so it always wins).

 - Sticky keys (&sk) and sticky layers (&sl) have a default waiting
   timeout of 1 second. This can be configured.

 - Mod-tap argument order:   &mt HOLD_KEY TAP_KEY
 - Layer-tap argument order: &lt HOLD_LAYER TAP_KEY

 - If using &tog 4, keep the toggle accessible on Red too:
   use &tog 4 at the same position, or &trans to inherit it.

 - If using &to 4, provide an accessible &to 0 binding to return.

 - Custom behaviors such as &cpp_deref_de must be defined in your
   keymap or an included file before you can use them.
===============================================================================
*/

/ {
    macros {
        cpp_deref: cpp_deref {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings 
                = <&kp SLASH>              // Correctly prints "-" on German Windows
                , <&kp LS(NON_US_BSLH)>;   // Correctly prints ">" on German Windows
        };
        // Your working C++ Dereferencing Operator (->)
        cpp_deref_de: cpp_deref_de {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_MINUS &kp DE_GREATER_THAN>;
        };

        // Bonus: C++ Scope Resolution Operator (::)
        cpp_scope: cpp_scope_de {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_COLON &kp DE_COLON>;
        };

        // C++ operator: !=. Emits characters only; no cursor movement.
        cpp_not_equal: cpp_not_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_EXCLAMATION &kp DE_EQUAL>;
        };

        // C++ operator: &&. Emits characters only; no cursor movement.
        cpp_logical_and: cpp_logical_and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_AMPERSAND &kp DE_AMPERSAND>;
        };

        // C++ operator: ||. Emits characters only; no cursor movement.
        cpp_logical_or: cpp_logical_or {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_PIPE &kp DE_PIPE>;
        };

        // C++ operator: <=. Emits characters only; no cursor movement.
        cpp_less_equal: cpp_less_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_LESS_THAN &kp DE_EQUAL>;
        };

        // C++ operator: >=. Emits characters only; no cursor movement.
        cpp_greater_equal: cpp_greater_equal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DE_GREATER_THAN &kp DE_EQUAL>;
        };
    };

    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"


      // Tap U = u, hold U = Num layer (2).
      // Before 280 ms, right-hand finger keys, the left Num digits, < and
      // Shift can trigger a hold. Other first keys favor a tap instead.
      // After the timeout, another key can activate Num regardless of position.
      // U within 150 ms of another non-modifier key always resolves as u.
      hl: hold_layer {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          retro-tap;
          hold-trigger-key-positions = <
              7 8 9 10 11 12 13  21 22 23 24 25 26 27  39 40 41 42 43 44 45
              54 55 56 57 58 59  71 72 73 74 75
              29 30 31 47 48 62  66
          >;
          bindings = <&mo>, <&kp>;
      };


      // ' and, with Shift, " (like on an English keyboard)
      // Tap 6 = 6, hold 6 (right ring, arrow row) = Edit layer (3). Same
      // safety timing as U; the layer only switches on if the next key is
      // on the left half, one of the right Edit keys (G C H T S) or a
      // modifier thumb key.
      he: hold_edit {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <280>;
          quick-tap-ms = <175>;
          require-prior-idle-ms = <150>;
          retro-tap;
          hold-trigger-key-positions = <
              14 15 16 17 18 19  28 29 30 31 32 33  46 47 48 49 50 51  63 64
              23 24 41 42 44  35 36 65 66 67
          >;
          bindings = <&mo>, <&kp>;
      };

      // Backspace; with Shift it is Delete (forward delete). Shift itself is
      // not sent with Delete, so it never becomes Shift+Delete (cut).
      bspc_del: backspace_delete {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp BSPC>, <&kp DEL>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // ; and, with Shift, [ (old arrow-key position)
      semi_bracket: semi_bracket {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DE_SEMICOLON>, <&kp DE_LEFT_BRACKET>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // = and, with Shift, ] (old arrow-key position)
      equal_bracket: equal_bracket {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DE_EQUAL>, <&kp DE_RIGHT_BRACKET>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // ( and, with Shift, { (old arrow-key position)
      paren_brace_l: paren_brace_l {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DE_LEFT_PARENTHESIS>, <&kp DE_LEFT_BRACE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // ) and, with Shift, } (old arrow-key position)
      paren_brace_r: paren_brace_r {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DE_RIGHT_PARENTHESIS>, <&kp DE_RIGHT_BRACE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // Tap Space = space, hold Space (200 ms) = Edit layer (3).
      // Tap-preferred: the layer only comes after holding, so fast rolls
      // like "word next" always type a space. Tap then hold = repeat spaces.
      hs: hold_space_edit {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "tap-preferred";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          bindings = <&mo>, <&kp>;
      };

      // Delete; with Shift it is Backspace (Shift is not passed on).
      del_bspc: delete_backspace {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DEL>, <&kp BSPC>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      // Backspace thumb: tap = Backspace (Shift: Delete), hold 200 ms = Edit
      // layer (3) for left-hand-only arrows. Tap then hold = repeat Backspace.
      hb: hold_backspace_edit {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "tap-preferred";
          tapping-term-ms = <200>;
          quick-tap-ms = <175>;
          bindings = <&mo>, <&bspc_del>;
      };

      // Tap Shift = sticky Shift, double-tap Shift = Caps Word (MAX_SIZE).
      td_shift: tap_dance_shift {
          compatible = "zmk,behavior-tap-dance";
          #binding-cells = <0>;
          tapping-term-ms = <200>;
          bindings = <&sk LSHIFT>, <&caps_word>;
      };

      sqt_dqt: single_double_quote {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DE_SINGLE_QUOTE>, <&kp DE_DOUBLE_QUOTES>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp F2           &kp DE_MINUS     &kp DE_2         &kp DE_3         &kp DE_4         &kp DE_PLUS      &none                                                                                            &mo 7            &kp DE_U_UMLAUT  &kp DE_7         &kp DE_8         &kp DE_9         &kp DE_SHARP_S   &kp DE_CARET
        &kp TAB          &sqt_dqt         &kp DE_COMMA     &kp DE_PERIOD    &kp DE_P         &kp DE_Y         &cpp_deref                                                                                       &none            &kp DE_F         &kp DE_G         &kp DE_C         &kp DE_R         &kp DE_L         &kp DE_O_UMLAUT
        &kp DE_LESS_THAN &kp DE_A         &kp DE_O         &kp DE_E         &hl 2 DE_U       &kp DE_I         &none                  &kp LCTRL        &kp LALT         &kp LGUI            &kp RALT            &none            &kp DE_D         &kp DE_H         &kp DE_T         &kp DE_N         &kp DE_S         &kp DE_0
        &del_bspc        &kp DE_1         &kp DE_Q         &kp DE_J         &kp DE_K         &kp DE_X                                                 &kp END          &none                                                    &kp DE_B         &kp DE_M         &kp DE_W         &kp DE_V         &kp DE_Z         &kp DE_U_UMLAUT
        &none            &kp DE_A_UMLAUT  &kp DE_5         &semi_bracket      &equal_bracket                                 &hb 3 0          &td_shift        &sl 1            &kp RCTRL           &hl 2 ENTER     &hs 3 SPACE                             &paren_brace_l   &paren_brace_r         &he 3 DE_6       &kp DE_HASH      &none
      >;
    };

    /* Red (symbol key, then a key). Placed by symbol frequency in C++ and
     * English; bracket pairs side by side (also on the Base arrow-row keys).
     *
     *          out pnk rng mid idx in            in  idx mid rng pnk out
     *   top            <=   [   ]                 #   ?   "   %  &&
     *   home   Esc  {   }   -   _  Tab            >=   (   )   /   *   +
     *   bottom     ||  ->   &   :   \             ~  ::   <   >  !=   ß
     *   arrow           ö   $   @                     €   |   !
     *
     *   Shift thumb = sticky Ctrl+Shift, Enter thumb = Ctrl+Enter.
     */
    extra1 {
      display-name = "Red";
      bindings = <
        &none                    &none                    &none                    &none                    &none                    &none                    &none  &none                    &none                    &none                    &none                    &none                    &none                    &none
        &none                    &none                    &cpp_less_equal          &kp DE_LEFT_BRACKET      &kp DE_RIGHT_BRACKET     &none                    &none  &none                    &kp DE_HASH              &kp DE_QUESTION          &kp DE_DOUBLE_QUOTES     &kp DE_PERCENT           &cpp_logical_and         &none
        &kp ESC                  &kp DE_LEFT_BRACE        &kp DE_RIGHT_BRACE       &kp DE_MINUS             &kp DE_UNDERSCORE        &kp TAB                  &none  &none                    &none                    &none                    &none                    &none                    &cpp_greater_equal       &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS &kp DE_SLASH             &kp DE_ASTERISK          &kp DE_PLUS
        &none                    &cpp_logical_or          &cpp_deref_de            &kp DE_AMPERSAND         &kp DE_COLON             &kp DE_BACKSLASH  &none                    &none                    &kp DE_TILDE             &cpp_scope               &kp DE_LESS_THAN         &kp DE_GREATER_THAN      &cpp_not_equal           &kp DE_SHARP_S
        &none                    &none                    &kp DE_O_UMLAUT          &kp DE_DOLLAR            &kp DE_AT &none                    &sk LC(LSHIFT)           &none                    &none                    &kp RC(ENTER)            &none                    &kp DE_EURO              &kp DE_PIPE              &kp DE_EXCLAMATION       &none                    &none
      >;
    };

    /* Num layer: hold U (left index) or Enter (right thumb); a tap types u / Enter.
     *
     *           out pnk rng mid idx           in  idx mid rng pnk out
     *   top          "   ,   .                 f   =   *   /   +
     *   home         9   5   6  [U] Tab        -   1   0   2   3  (0)
     *   bottom      (1)  <   >                 ?   4   7   8   :
     *   arrow           (5)                               (6)
     *
     *   Direct operators: Base G =, C *, R /, Q <, J >; L +, D -, B ? and Z :; " on the left pinky top key.
     *   Base F stays f for float literals such as 0.5f. Empty letter keys
     *   do nothing. Number row, Tab, Del, ; = ( ), # and thumb controls keep
     *   their usual functions. Holding Enter also opens this layer.
     *   (x) = same key as on Base. Shift + digit gives its German symbol:
     *   Shift+0 =   Shift+1 !   Shift+5 %   Shift+7 /   Shift+8 (   Shift+9 )
     */
    extra2 {
      display-name = "Num";
      bindings = <
        &trans           &trans           &trans           &trans           &trans           &trans           &trans                                                                                           &trans           &trans           &trans           &trans           &trans           &trans           &trans
        &trans           &kp DE_DOUBLE_QUOTES &trans           &trans           &none            &none            &trans                                                                                           &trans           &trans           &kp DE_EQUAL     &kp DE_ASTERISK  &kp DE_SLASH     &kp DE_PLUS      &none
        &trans           &kp DE_9         &kp DE_5         &kp DE_6         &trans           &kp TAB          &trans                 &trans           &trans           &trans           &trans                 &trans           &kp DE_MINUS     &kp DE_1         &kp DE_0         &kp DE_2         &kp DE_3         &trans
        &trans           &trans           &kp DE_LESS_THAN &kp DE_GREATER_THAN &none            &none                                                    &trans           &trans                                                   &kp DE_QUESTION  &kp DE_4         &kp DE_7         &kp DE_8         &kp DE_COLON     &none
        &trans           &none            &trans           &trans           &trans                                  &trans           &trans           &trans           &trans           &kp ENTER        &trans                                  &trans           &trans           &trans           &trans           &trans
      >;
    };

    /* Edit: hold the 6 key (right ring finger, arrow row), or Space or
     * Backspace for 200 ms (Backspace = arrows with the left hand only).
     * Left home row: A Left, O Down, E Up, U Right. Shift/Ctrl still work.
     * Number row: F1-F12.
     * Left index: I Tab (Shift+I = Shift+Tab), K Delete.
     * Left bottom row: pinky Backspace, ring Delete, middle Backspace.
     * Old arrow keys (left, bottom row): Left and Right as before.
     * Right home: H definition, T back, S toggle line comment.
     * Right upper: G references, C quick fix.
     * Left upper (ring finger holds 6): , rename, . next problem.
     * F13-F19 are mapped in VS Code; see config/vscode-keybindings.json.
     * Esc is at the original Esc position. Unused letter keys do nothing.
     * Release the key to return.
     */
    extra3 { 
      display-name = "Edit";
      bindings = <
        &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6           &trans                                                                                                       &trans           &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12
        &trans           &none            &kp F15          &kp F19          &none            &none            &none                                                                                            &none            &none            &kp F17          &kp F18          &none            &none            &none
        &kp ESC          &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp TAB          &none                  &trans           &trans           &trans           &trans                 &none            &none            &kp F13          &kp F14          &none            &kp F16          &trans
        &trans           &kp BSPC         &kp DEL          &kp BSPC         &kp DEL          &none                                                    &trans           &none                                                    &none            &none            &none            &none            &none            &none
        &trans           &trans           &trans           &kp LEFT         &kp RIGHT                               &trans           &trans           &trans           &trans           &trans           &trans                                  &trans           &trans           &trans           &trans           &trans
      >;
    };

    free4 {
      display-name = "Free 4";
      bindings = <
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                  &none            &none            &none            &none                  &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none                                                    &none            &none                                                    &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none
      >;
    };

    free5 {
      display-name = "Free 5";
      bindings = <
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                  &none            &none            &none            &none                  &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none                                                    &none            &none                                                    &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none
      >;
    };

    free6 {
      display-name = "Free 6";
      bindings = <
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                                                                                            &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &none                  &none            &none            &none            &none                  &none            &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none                                                    &none            &none                                                    &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &none
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none            &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &none                                                                                            &trans           &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none            &none            &bootloader                                                                                      &bootloader      &none            &none            &none            &none            &none            &none
        &studio_unlock   &none            &none            &none            &none            &none            &none                  &none            &none            &bt BT_CLR       &none                  &stp STP_BAT     &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &macro_ver       &none                                                    &none            &none                                                    &none            &none            &none            &none            &none            &none
        &none            &none            &none            &none            &none                                   &none            &none            &none            &none            &bl BL_TOG       &rgb_ug RGB_TOG                         &bl BL_INC       &bl BL_DEC       &none            &none            &none
      >;
    };
  };
};

// Caps Word (double-tap Shift) keeps going through _ (German _ is Shift
// plus the - key), Backspace and Delete; Space, Enter, . and , end it.
&caps_word {
    continue-list = <DE_UNDERSCORE BSPC DEL>;
};
